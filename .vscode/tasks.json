{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        //hub will normally run on the pi this is just here for occasional use and testing
        {
            "label": "hub",
            "type": "shell",
            "command": "source venv/bin/activate  && python3 -m hub",
        },
        {
            "label": "calibrate-tyre-tracker",
            "type": "shell",
            "command": "source venv/bin/activate  && python3 -m composed_robot.computer_vision.tyre_tracker.calibration",
        },
        {
            "label": "aruco-location",
            "type": "shell",
            "command": "source venv/bin/activate  && python3 -m composed_robot.collection.aruco_location_node",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "group": "experiment1"
            }
        },
        {
            "label": "location-tracker",
            "type": "shell",
            "command": "source venv/bin/activate  && python3 -m composed_robot.collection.location_tracker_node",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "group": "experiment1"
            }
        },
        {
            "label": "object-locator",
            "type": "shell",
            "command": "source venv/bin/activate  &&  python3 -m composed_robot.collection.object_locator_node",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "group": "experiment1"
            }
        },
        {
            "label": "collection",
            "dependsOn": [
                "location-tracker",
                //"object-locator",
                "aruco-location"
            ]
        },
       
    ]
}